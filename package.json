{
  "name": "@konigi/tokens",
  "version": "1.0.4",
  "description": "Design tokens shared across Konigi apps. Code is truth; Figma is generated from it.",
  "private": true,
  "type": "module",
  "files": [
    "tokens.css",
    "invariants.json",
    "scripts"
  ],
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./invariants.json": "./invariants.json",
    "./check": "./scripts/check.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check.mjs --tokens tokens.css --invariants invariants.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
